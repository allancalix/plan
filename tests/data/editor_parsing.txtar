# With stdout a terminal, plan opens the editor (the harness defaults it to cat)
env PLAN_MOCK_TTY=1 plan
# Editors with arguments are split with shell quoting rules
env PLAN_MOCK_TTY=1 VISUAL="cat -n" plan
# Piped, plan prints the plan and never runs the editor
env VISUAL=false plan
-- 2026-02-19.plan --
2026, Feb 19 - Thursday
~~~~~~~~~inbox~~~~~~~~~
~~~~~~~~~~~~~~~~~~~~~~~

