# The message goes after -m; with no selector it logs into today's plan
plan -m "ship the thing"
# Words that look like commands or flags are fine as messages
plan @ -m ls
plan -m "search for the bug"
plan -m "-leading dash"
# Unquoted words get a suggestion with the quotes in place
! plan -m fix the build
! plan yesterday forgot this
! plan ship the thing
! plan @~x more
plan
-- 2026-02-19.plan --
