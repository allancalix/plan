# then deleting the inbox markers entirely.
replace "~~~~~~~~~inbox~~~~~~~~~" "" 2026-02-19.plan
replace "~~~~~~~~~~~~~~~~~~~~~~~" "" 2026-02-19.plan
# 3. Insert a new item - it should safely recreate the inbox block at the bottom
plan -m "task 2"
# 4. Print the plan file to verify the layout
plan
