# Plans on a few days, spread over two months and a year boundary
>> forward -110 days
plan -m "a november plan"
>> forward 75 days
plan -m "mid january"
>> forward 17 days
plan -m "first of february"
>> forward 7 days
plan -m "the eighth"
>> forward 11 days
plan -m "today"
# A day prints that plan; a set prints the list, newest first
plan 2026-02-08
plan ..
plan 01
plan 2026-02
plan @~11..
plan ..2026-01
plan 2025..2026-01
# A set that matches one plan still lists it when piped
plan 11-01
# Nothing matches: exit 2, quietly when piped
! plan 2027
# -m and --show-path need exactly one plan
plan 11-01 -m "logged through a unique fragment"
! plan 01 -m "which one?"
! plan --show-path 2026-02
! env PLAN_MOCK_TTY=1 plan 2027
# search narrowed with --in
plan search the --in 2026-02
plan search a --in @~18..@~11
! plan --in @
# Malformed selectors
! plan 13-01
! plan 2026-02-30
! plan 11-01..
! plan 1..2..3
-- 2025-11-01.plan --
2025, Nov 01 - Saturday
~~~~~~~~~inbox~~~~~~~~~
00:00 a november plan
00:00 logged through a unique fragment
~~~~~~~~~~~~~~~~~~~~~~~

